# provision-sitecore-ai-component — Authoring API (check/push only; see README "Authentication")
# Prefer the one-time setup.sh credential bootstrap, which writes these once per machine
# to ~/.config/provision-sitecore-ai-component/.env (chmod 600); a repo-root .env overrides it.
# Blank values are treated as unset, so this template can coexist with central credentials.
SITECORE_AUTHORING_CLIENT_ID=
SITECORE_AUTHORING_CLIENT_SECRET=
SITECORE_AUTHORING_ENDPOINT=
# Optional — defaults: https://auth.sitecorecloud.io/oauth/token / https://api.sitecorecloud.io
SITECORE_AUTHORING_TOKEN_URL=
SITECORE_AUTHORING_AUDIENCE=
