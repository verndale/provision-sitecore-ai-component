#!/usr/bin/env sh
while read -r local_ref local_oid remote_ref remote_oid; do
  if [ "$remote_ref" = 'refs/heads/main' ]; then
    echo 'Direct pushes to main are blocked. Open an issue-linked PR.' >&2
    exit 1
  fi
done
for git_environment_variable in $(git rev-parse --local-env-vars); do
  unset "$git_environment_variable"
done
unset git_environment_variable
pnpm run verify:push
