{
  "version": 1,
  "component": "GeneralImageCard",
  "slug": "general-image-card",
  "output": "artifacts/general-image-card",
  "confluence": {
    "url": "https://verndale.atlassian.net/wiki/spaces/CN/pages/6784221476/CN+-+General+Image+Card",
    "pageId": "6784221476"
  },
  "templates": [
    {
      "role": "datasource",
      "kind": "content",
      "name": "General Image Card",
      "standardValues": true,
      "baseTemplates": [
        "/sitecore/templates/System/Templates/Standard template",
        "/sitecore/templates/Foundation/Experience Accelerator/StandardValues/_PerSiteStandardValues"
      ],
      "icon": "Office/32x32/window_dialog.png",
      "sections": [
        {
          "name": "Content",
          "fields": [
            {
              "name": "generalImageCardImage",
              "title": "General Image Card Image",
              "sitecoreType": "Image",
              "source": "query:$siteMedia",
              "helpText": "Optional thumbnail image. When empty, the card renders as text only; alt text comes from the selected media asset."
            },
            {
              "name": "generalImageCardHeading",
              "title": "General Image Card Heading",
              "sitecoreType": "Single-Line Text",
              "required": true,
              "helpText": "Required card title. The card does not render on the live site when this value is empty."
            },
            {
              "name": "generalImageCardDescription",
              "title": "General Image Card Description",
              "sitecoreType": "Multi-Line Text",
              "helpText": "Optional supporting text displayed below the card heading."
            },
            {
              "name": "generalImageCardLink",
              "title": "General Image Card Link",
              "sitecoreType": "General Link",
              "required": true,
              "source": "query:$linkableHomes",
              "helpText": "Required internal or external destination used by the entire clickable card."
            }
          ]
        }
      ]
    },
    {
      "role": "datasource",
      "kind": "folder",
      "name": "General Image Card Folder",
      "standardValues": true,
      "baseTemplates": [
        "/sitecore/templates/System/Templates/Standard template"
      ],
      "icon": "Office/32x32/folder_window.png",
      "insertOptions": [
        "General Image Card",
        "General Image Card Folder"
      ]
    },
    {
      "role": "renderingParameters",
      "kind": "renderingParameters",
      "name": "General Image Card Parameters",
      "standardValues": true,
      "baseTemplates": [
        "/sitecore/templates/Foundation/JSS Experience Accelerator/Presentation/Rendering Parameters/BaseRenderingParameters",
        "/sitecore/templates/Foundation/Experience Accelerator/Dynamic Placeholders/Rendering Parameters/IDynamicPlaceholder",
        "/sitecore/templates/Foundation/Experience Accelerator/StandardValues/_PerSiteStandardValues",
        "/sitecore/templates/Foundation/Experience Accelerator/Markup Decorator/Rendering Parameters/IRenderingId"
      ],
      "icon": "sxa/16x16/promo.png"
    }
  ],
  "rendering": {
    "name": "General Image Card",
    "componentName": "GeneralImageCard",
    "datasourceTemplate": "General Image Card",
    "parametersTemplate": "General Image Card Parameters",
    "datasourceLocation": "./Data|query:$site/*[@@name='Data']/*[@@templatename='General Image Card Folder']|query:$sharedSites/*[@@name='Data']/*[@@templatename='General Image Card Folder']",
    "openPropertiesAfterAdd": false,
    "enableDatasourceQuery": true,
    "icon": "SXA_MDI/16x16/Promo.png"
  },
  "sxa": {
    "folderTemplate": "General Image Card Folder",
    "siteScaffolding": {
      "branchRoot": "/sitecore/templates/Branches/Project/Training App Router",
      "setupRoot": "/sitecore/system/Settings/Project/Training App Router/Training App Router ",
      "moduleName": "Training App Router",
      "dataActionName": "Add General Image Card Data Item"
    },
    "sites": [
      {
        "siteRoot": "/sitecore/content/Training App Router/Basic Site",
        "availableRenderingsCategory": "Training App Router",
        "createDataFolder": true,
        "createHeadlessVariant": true,
        "createAvailableRenderingsCategory": true
      }
    ]
  },
  "sitecorePaths": {
    "templateRoots": {
      "datasource": "/sitecore/templates/Project/Training App Router",
      "renderingParameters": "/sitecore/templates/Project/Training App Router/Rendering Parameters"
    },
    "renderingRoot": "/sitecore/layout/Renderings/Project/Training App Router"
  }
}
