              "helpText": "Required. Component must not render if empty."
            },
            {
              "name": "imageCtaRowBodyText",
              "title": "Image CTA Row Body Text",
              "sitecoreType": "Multi-Line Text",
              "helpText": "Optional supporting copy. Omit when empty."
            },
            {
              "name": "primaryLink",
              "title": "Primary Link",
              "sitecoreType": "General Link",
              "required": true,
              "helpText": "Required. Provides both CTA destination and visible button label."
            },
            {
              "name": "openInModal",
              "title": "Open In Modal",
              "sitecoreType": "Checkbox",
              "helpText": "Default unchecked. Controls CTA behavior only."
            },
            {
              "name": "imageCtaRowImage",
              "title": "Image CTA Row Image",
              "sitecoreType": "Image",
              "required": true,
              "helpText": "Required. Same asset used across breakpoints. Alt text must be authored on the selected image."
            },
            {
              "name": "theme",
              "title": "Theme",
              "sitecoreType": "Droplist",
              "required": true,
              "defaultValue": "light",
              "optionSource": {
                "searchRoot": "/sitecore/content/Training App Router",
                "itemTemplate": "Option",
                "valueField": "value",
                "options": [
                  { "name": "light", "displayName": "Light", "value": "light" },
                  { "name": "dark", "displayName": "Dark", "value": "dark" }
                ],
                "fallback": {
                  "path": "/sitecore/content/Training App Router/Basic Site/Data/Theme"
                }
              },
              "helpText": "Default light. Values should be light=Light and dark=Dark."
            },
            {
              "name": "fullBleedIllustration",
              "title": "Full-bleed Illustration",
              "sitecoreType": "Checkbox",
              "helpText": "Default unchecked. Desktop-only presentation flag."
            }
          ]
        }
      ]
    },
